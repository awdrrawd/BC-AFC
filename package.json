{
  "name": "bc-afc",
  "private": true,
  "version": "0.7.3",
  "type": "module",
  "description": "Abundantia Florum ─Chromatica─ (AFC) — Extended Lover System for Bondage Club (bundles Heart Lock)",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "vite build && concurrently -k -n build,serve \"vite build --watch\" \"vite preview --port 5175\"",
    "preview": "vite preview --port 5175",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test",
    "check:assets": "node scripts/check-assets.mjs",
    "check:orphans": "node scripts/check-orphans.mjs",
    "check:bc": "node scripts/check-bc-compat.mjs",
    "check": "npm run lint && npm test && npm run check:orphans",
    "setup-hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "vite": "^8.3.5"
  }
}
